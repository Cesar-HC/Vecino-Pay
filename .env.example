# Copia este archivo como .env. PostgreSQL 17 local, sin Docker.
PGHOST=127.0.0.1
PGPORT=5432
# Vacío: se busca psql en el PATH y luego en C:\Program Files\PostgreSQL\17\bin\psql.exe
PSQL_BIN=
DB_NAME=vecinopay
DB_OWNER_USER=vecinopay_owner
DB_OWNER_PASSWORD=VecinoOwner2026dev
APP_DB_USER=vecinopay_app
APP_DB_PASSWORD=VecinoApp2026dev
# La API (nunca postgres ni el dueño). Si cambias APP_DB_PASSWORD, cámbiala aquí y vuelve a correr npm run db:roles.
DATABASE_URL=postgresql://vecinopay_app:VecinoApp2026dev@127.0.0.1:5432/vecinopay?schema=public
PORT=3000
WEB_PORT=8080
JWT_SECRET=cambia-este-secreto
TZ=America/Lima
NODE_ENV=development
# Fecha fija de la demo. Déjala vacía para usar la hora real. La API no arranca en producción si tiene valor.
RELOJ_FIJO=2026-09-22T12:00:00-05:00
