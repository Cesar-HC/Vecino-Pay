# Copia este archivo como .env y ajusta si hace falta.
# La contraseña de SQL Server debe tener 8+ caracteres con mayúscula, minúscula, número y símbolo.
MSSQL_SA_PASSWORD=VecinoPay#2026
DB_NAME=VecinoPay
DB_PORT=1433
API_PORT=3000
WEB_PORT=8080
JWT_SECRET=cambia-este-secreto
TZ=America/Lima
# Usuario de la API en SQL Server (nunca sa). Sin comillas simples, ";", "=" ni llaves.
APP_DB_PASSWORD=VecinoApp#2026
NODE_ENV=development
# Fecha fija de la demo. Déjala vacía para usar la hora real. La API no arranca en producción si tiene valor.
RELOJ_FIJO=2026-09-22T12:00:00-05:00
# Solo para desarrollo local fuera de Docker.
DATABASE_URL=sqlserver://127.0.0.1:1433;database=VecinoPay;user=vecinopay_app;password=VecinoApp#2026;encrypt=true;trustServerCertificate=true
